<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Anyma — Cyber Services, Software & Hardware</title>
  <meta name="description" content="Cyberpunk-style IT services, custom software, and curated hardware for edgy teams and creators." />
  <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700&family=Source+Code+Pro:wght@300;600&display=swap" rel="stylesheet">
  <style>
    :root{
      --bg:#05030a; --glass:rgba(255,255,255,0.04);
      --neon-pink:#ff2d95; --neon-cyan:#00f0ff; --accent:#a0ff6e;
      --mono:'Source Code Pro', monospace; --display:'Orbitron', sans-serif;
    }
    *{box-sizing:border-box}
    html,body{height:100%}
    body{
      margin:0; font-family:var(--mono); background:radial-gradient(1200px 600px at 10% 10%, rgba(0,240,255,0.03), transparent),
        linear-gradient(180deg,#020111 0%, #09051a 50%, #05030a 100%);
      color:#e6eef8; -webkit-font-smoothing:antialiased; -moz-osx-font-smoothing:grayscale;
    }
    .wrap{max-width:1100px;margin:40px auto;padding:28px}

    header{display:flex;align-items:center;justify-content:space-between}
    .brand{display:flex;gap:16px;align-items:center}
    .logo{
      width:56px;height:56px;border-radius:10px;background:linear-gradient(135deg,var(--neon-pink),var(--neon-cyan));
      display:flex;align-items:center;justify-content:center;box-shadow:0 6px 30px rgba(0,0,0,0.6),0 0 28px rgba(0,240,255,0.08) inset;
      font-family:var(--display);font-weight:700;color:#05030a
    }
    .title h1{margin:0;font-family:var(--display);font-size:1.25rem;letter-spacing:1px}
    .title p{margin:0;font-size:0.78rem;opacity:0.8}
    nav{display:flex;gap:14px}
    .btn{background:transparent;border:1px solid rgba(255,255,255,0.08);padding:10px 14px;border-radius:8px;color:var(--neon-cyan);cursor:pointer;backdrop-filter: blur(6px)}
    .btn.primary{background:linear-gradient(90deg,var(--neon-pink),var(--neon-cyan));color:#05030a;border:0;font-weight:700}

    .hero{display:grid;grid-template-columns:1fr 420px;gap:28px;margin-top:28px;align-items:start}
    .panel{background:linear-gradient(180deg, rgba(255,255,255,0.02), rgba(255,255,255,0.01));padding:22px;border-radius:14px;border:1px solid rgba(255,255,255,0.03);box-shadow:0 10px 40px rgba(0,0,0,0.6)}
    .hero-left h2{font-family:var(--display);font-size:2rem;margin:0 0 8px}
    .hero-left p{margin:0 0 18px;opacity:0.9}
    .features{display:flex;gap:12px;flex-wrap:wrap}
    .chip{padding:8px 12px;border-radius:999px;background:rgba(255,255,255,0.02);border:1px solid rgba(255,255,255,0.02);font-size:0.8rem}

    .terminal{background:#07060b;padding:16px;border-radius:10px;color:#bfefff;font-family:var(--mono);font-size:0.9rem;line-height:1.5;overflow:auto;border:1px solid rgba(0,240,255,0.06)}
    .prompt{color:var(--neon-cyan);}

    .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:22px}
    .card{padding:18px;border-radius:12px;background:linear-gradient(180deg, rgba(255,255,255,0.01), transparent);border:1px solid rgba(255,255,255,0.03)}
    .card h3{margin:0 0 8px;font-family:var(--display);font-size:1.1rem}
    .price{font-weight:800;font-size:1.25rem;color:var(--accent)}
    .card p{margin:10px 0 16px;opacity:0.85;font-size:0.92rem}
    .buy{display:inline-block;padding:10px 12px;border-radius:10px;background:transparent;border:1px solid rgba(255,255,255,0.05);cursor:pointer}

    .pricing{margin-top:28px;display:flex;gap:18px}
    .large{flex:1;padding:20px;border-radius:12px}

    footer{margin-top:42px;display:flex;justify-content:space-between;align-items:center;padding:12px 8px;font-size:0.85rem;opacity:0.9}

    @media (max-width:980px){.hero{grid-template-columns:1fr;}.grid{grid-template-columns:repeat(2,1fr)} }
    @media (max-width:640px){.grid{grid-template-columns:1fr}.wrap{margin:16px}}

    .glitch{position:relative}
    .glitch::after,.glitch::before{content:attr(data-text);position:absolute;left:0;top:0;opacity:0.6}
    .glitch::before{color:var(--neon-pink);transform:translate(-2px,-1px);mix-blend-mode:screen}
    .glitch::after{color:var(--neon-cyan);transform:translate(2px,1px);mix-blend-mode:screen}
  </style>
</head>
<body>
  <div class="wrap">
    <header>
      <div class="brand">
        <div class="logo">A</div>
        <div class="title">
          <h1>Anyma</h1>
          <p>Code. Secure. Deliver.</p>
        </div>
      </div>
      <nav>
        <a class="btn" href="services.html">Services</a>
        <a class="btn" href="shop.html">Shop</a>
        <a class="btn" href="contact.html">Contact</a>
        <a class="btn primary" href="quote.html">Get a Quote</a>
      </nav>
    </header>

    <main class="hero">
      <div class="panel hero-left">
        <h2 class="glitch" data-text="Cyberpunk IT for the modern edge">Cyberpunk IT for the modern edge</h2>
        <p>We design secure infrastructure, build custom software, and craft high-performance hardware stacks — with a noir aesthetic and hacker-first mindset.</p>
        <div class="features">
          <span class="chip">Pentest & Red Team</span>
          <span class="chip">Custom SaaS & APIs</span>
          <span class="chip">Edge & IoT Hardware</span>
          <span class="chip">DevOps / CI & CD</span>
          <span class="chip">Rapid Prototyping</span>
        </div>

        <div style="margin-top:18px;display:flex;gap:10px;align-items:center">
          <a class="btn primary" href="services.html">Explore Services</a>
          <a class="btn" href="shop.html">Browse Hardware</a>
        </div>

        <section style="margin-top:18px">
          <div class="terminal" id="terminal">
            <div><span class="prompt">anyma@core</span>:~$ <span id="type">Initializing secure link...</span></div>
          </div>
        </section>
      </div>

      <aside class="panel" style="height:100%">
        <h3 style="margin-top:0">Quick Quote</h3>
        <p style="margin:6px 0 14px;opacity:0.9">Tell us what you need — we'll respond within 24 hours.</p>
        <form id="contactForm" action="quote.html" method="get">
          <label style="font-size:0.85rem;opacity:0.9">Email</label>
          <input type="email" name="email" required style="width:100%;padding:10px;margin:6px 0;border-radius:8px;border:1px solid rgba(255,255,255,0.04);background:transparent;color:inherit">
          <label style="font-size:0.85rem;opacity:0.9">Project summary</label>
          <textarea name="summary" rows="4" style="width:100%;padding:10px;margin:6px 0;border-radius:8px;border:1px solid rgba(255,255,255,0.04);background:transparent;color:inherit"></textarea>
          <div style="display:flex;gap:8px;margin-top:8px">
            <button class="btn primary" type="submit">Send Quote</button>
            <a class="btn" href="contact.html">Email Us</a>
          </div>
        </form>
      </aside>
    </main>

    <footer>
      <div>© <span id="year"></span> Anyma — Built like a cipher.</div>
      <div style="display:flex;gap:10px"><a class="btn" href="services.html">Services</a><a class="btn" href="shop.html">Shop</a><a class="btn" href="contact.html">Contact</a></div>
    </footer>
  </div>

  <script>
    const lines = ['secure channel open', 'scanning ports', 'handshake complete', 'ready for deployment'];
    let idx=0;const el=document.getElementById('type');
    function tick(){el.textContent='\u25C8 ' + lines[idx%lines.length]; idx++;}
    tick(); setInterval(tick,2500);

    document.getElementById('year').textContent = new Date().getFullYear();
  </script>
</body>
</html>
